# Production frontend config. Loaded automatically by `next build`.
# Vercel will also inject these from the project env settings — the file
# exists so a `npm run build` from CI or your laptop produces the same
# bundle as Vercel does.

NEXT_PUBLIC_API_BASE=https://api.ayvid.ai/api/v1

# Soft access gate on /console. Override in Vercel env if you rotate it.
# Not a real auth boundary — the FastAPI layer is. Keeps casual scrapers
# off the operations console.
NEXT_PUBLIC_CONSOLE_PASSPHRASE=ayvid
