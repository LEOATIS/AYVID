# syntax=docker/dockerfile:1.7
# Execution worker: runs the live paper-trading runner against IB or in shadow mode.
# Reuses the python wheels built for the API to keep images consistent.

FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install --no-install-recommends -y \
        build-essential gcc && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml ./
RUN pip install --upgrade pip && \
    pip wheel --wheel-dir /wheels "setuptools>=61.0" "wheel" && \
    pip wheel --wheel-dir /wheels .


FROM python:3.12-slim AS runtime

# Build-time identity: stamped by CI via --build-arg so /api/v1/system/build
# and live/deploy_marker.json can prove which commit is running. The
# smoke test in deploy-gcp.yml asserts these match GITHUB_SHA.
ARG BUILD_SHA=dev
ARG BUILD_TIME=unknown
ENV BUILD_SHA=${BUILD_SHA} \
    BUILD_TIME=${BUILD_TIME}
LABEL build_sha=${BUILD_SHA}
LABEL build_time=${BUILD_TIME}

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install --no-install-recommends -y tini && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup --system --gid 1001 ayvid && \
    adduser  --system --uid 1001 --gid 1001 --home /app ayvid

WORKDIR /app

COPY --from=builder /wheels /wheels
COPY pyproject.toml ./
RUN pip install --no-index --find-links=/wheels --no-build-isolation \
        "setuptools>=61.0" "wheel" && \
    pip install --no-index --find-links=/wheels --no-build-isolation . && \
    rm -rf /wheels

COPY --chown=ayvid:ayvid . .
RUN mkdir -p /app/live && chown -R ayvid:ayvid /app

# OpenBB writes a `.build.lock` file inside its site-packages dir on
# the first import each process. With the default site-packages
# ownership (root from `pip install`), every runtime call from the
# uid=1001 ayvid user fails with `[Errno 13] Permission denied:
# /usr/local/lib/python3.12/site-packages/openbb/.build.lock`. Five
# stages of run_ingestion_cycle hit OpenBB — news fetch, NER feed,
# market-data ingest, pre-compute, auto-execute — so the May 3
# incident logged "0 signals minted" every cycle. chown the OpenBB
# package dir so the runtime user can write its lock without
# escalating any other site-packages perms.
RUN chown -R ayvid:ayvid /usr/local/lib/python3.12/site-packages/openbb

USER ayvid

# P1-16: healthcheck for the execution worker. Writes a tiny JSON
# line to `/app/live/equity_curve.jsonl` on every cycle, so a stale
# file mtime means the runner is wedged. The check tolerates an age
# of 3× the configured cycle interval (default 60s → 180s window).
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import os, time; p='/app/live/equity_curve.jsonl'; \
import sys; sys.exit(0 if os.path.exists(p) and (time.time() - os.stat(p).st_mtime) < 300 else 1)"

ENTRYPOINT ["/usr/bin/tini", "--"]
# Default: shadow paper-trading with continuous pipeline.
# To run against IB Gateway, override CMD and drop --shadow:
#   docker run --rm ayvid-execution python -m cli.app trade paper-start --with-pipeline --equity 1000000
CMD ["python", "-m", "cli.app", "trade", "paper-start", "--shadow", "--with-pipeline", "--equity", "1000000", "--interval", "60"]
