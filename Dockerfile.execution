# syntax=docker/dockerfile:1.7
# Execution worker: runs the live paper-trading runner against IB or in shadow mode.
# Reuses the python wheels built for the API to keep images consistent.

FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install --no-install-recommends -y \
        build-essential gcc && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml ./
RUN pip wheel --wheel-dir /wheels .


FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install --no-install-recommends -y tini && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup --system --gid 1001 ayvid && \
    adduser  --system --uid 1001 --gid 1001 --home /app ayvid

WORKDIR /app

COPY --from=builder /wheels /wheels
COPY pyproject.toml ./
RUN pip install --no-index --find-links=/wheels . && rm -rf /wheels

COPY --chown=ayvid:ayvid . .
RUN mkdir -p /app/live && chown -R ayvid:ayvid /app

USER ayvid

ENTRYPOINT ["/usr/bin/tini", "--"]
# Default: shadow paper-trading. To run against IB Gateway, override CMD and drop --shadow:
#   docker run --rm ayvid-execution python -m cli.app trade paper-start --equity 1000000
CMD ["python", "-m", "cli.app", "trade", "paper-start", "--shadow", "--equity", "1000000", "--interval", "60"]
