# ============================================================
# AYVID - Asymmetric Yield Via Intelligent Decisions
# Environment Configuration
# ============================================================

# --- LLM Providers ---
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_PROVIDER=openai

# --- OpenBB Data ---
OPENBB_FMP_API_KEY=your_fmp_key_here
OPENBB_FRED_API_KEY=your_fred_key_here
OPENBB_PAT=your_openbb_pat_here
OPENBB_BENZINGA_API_KEY=your_benzinga_key_here
OPENBB_TIINGO_API_KEY=your_tiingo_key_here
OPENBB_INTRINIO_API_KEY=your_intrinio_key_here

# --- Finnhub (Real-Time News + Sentiment) ---
FINNHUB_API_KEY=your_finnhub_key_here

# --- SEC EDGAR ---
# SEC requires a valid contact email in User-Agent header (their TOS)
SEC_EDGAR_EMAIL=your_email@example.com

# --- Neo4j (Supply Chain Topology) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# --- Qdrant (Semantic Vectors) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ayvid_events

# --- Embeddings ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- QuestDB (Time-Series Ticks) ---
QUESTDB_HOST=localhost
QUESTDB_PORT=9009
QUESTDB_HTTP_PORT=9000

# --- Hopsworks (Feature Store) ---
HOPSWORKS_API_KEY=your_hopsworks_key_here
HOPSWORKS_PROJECT=ayvid

# --- Interactive Brokers (Paper Trading) ---
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
IB_ACCOUNT=

# --- Risk Limits ---
MAX_DRAWDOWN_PCT=3.0
KELLY_FRACTION=0.5
MAX_POSITION_PCT=5.0
PRE_MARKET_DELAY_MINUTES=15

# --- API Authentication ---
# Set to enable X-API-Key header auth on all endpoints (leave blank for dev mode)
API_KEY=

# --- Application ---
LOG_LEVEL=INFO
PAPER_TRADING=true
# Enable auto-execution from signal book after pre-compute (live trading only)
AUTO_EXECUTE=false
# Toggle backend auto-start of the continuous ingestion worker.
# Keep false for local API/frontend development; set true for unattended runs.
CONTINUOUS_PIPELINE_ENABLED=false
# Enable live LLM orchestrator (full causal pipeline on every signal)
LLM_LIVE_ORCHESTRATOR=false
