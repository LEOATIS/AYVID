# ============================================================
# AYVID - Asymmetric Yield Via Intelligent Decisions
# Environment Configuration
# ============================================================

# --- LLM Providers ---
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_PROVIDER=openai

# --- OpenBB Data ---
OPENBB_FMP_API_KEY=your_fmp_key_here
OPENBB_FRED_API_KEY=your_fred_key_here
OPENBB_PAT=your_openbb_pat_here
OPENBB_BENZINGA_API_KEY=your_benzinga_key_here
OPENBB_TIINGO_API_KEY=your_tiingo_key_here
OPENBB_INTRINIO_API_KEY=your_intrinio_key_here

# --- Finnhub (Real-Time News + Sentiment) ---
FINNHUB_API_KEY=your_finnhub_key_here

# --- MCP Connectors (anthropic/financial-services integration) ---
# Each MCP_*_URL is OPTIONAL. When unset (default), AYVID falls back to
# its existing extractor paths (news scraper, OpenBB, Finnhub, SEC EDGAR).
# Set the URL + API key for any vendor you have a subscription with;
# the continuous worker and equity-research skills will then prefer
# the vendor feed. Endpoint URLs mirror anthropic/financial-services
# /plugins/vertical-plugins/financial-analysis/.mcp.json.
#
# MT Newswires — real-time market news (shock detection feed)
# MCP_MT_NEWSWIRES_URL=https://vast-mcp.blueskyapi.com/mtnewswires
# MCP_MT_NEWSWIRES_API_KEY=
#
# Aiera — earnings call transcripts (earnings-analysis / earnings-preview skills)
# MCP_AIERA_URL=https://mcp-pub.aiera.com
# MCP_AIERA_API_KEY=
#
# FactSet — multi-asset fundamentals + consensus + IV
# MCP_FACTSET_URL=https://mcp.factset.com/mcp
# MCP_FACTSET_API_KEY=
#
# Moody's — credit ratings (ETFs & bonds asset class)
# MCP_MOODYS_URL=https://api.moodys.com/genai-ready-data/m1/mcp
# MCP_MOODYS_API_KEY=
#
# S&P Global / Capital IQ — sector benchmarks + tear sheets
# MCP_SP_GLOBAL_URL=https://kfinance.kensho.com/integrations/mcp
# MCP_SP_GLOBAL_API_KEY=

# --- SEC EDGAR ---
# SEC requires a valid contact email in User-Agent header (their TOS)
SEC_EDGAR_EMAIL=your_email@example.com

# --- Neo4j (Supply Chain Topology) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# --- Qdrant (Semantic Vectors) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ayvid_events

# --- Embeddings ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- QuestDB (Time-Series Ticks) ---
QUESTDB_HOST=localhost
QUESTDB_PORT=9009
QUESTDB_HTTP_PORT=9000

# --- Hopsworks (Feature Store) ---
HOPSWORKS_API_KEY=your_hopsworks_key_here
HOPSWORKS_PROJECT=ayvid

# --- Interactive Brokers (Paper Trading) ---
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
IB_ACCOUNT=

# --- Risk Limits ---
MAX_DRAWDOWN_PCT=3.0
KELLY_FRACTION=0.5
MAX_POSITION_PCT=5.0
PRE_MARKET_DELAY_MINUTES=15

# --- API Authentication ---
# Set to enable X-API-Key header auth on all endpoints (leave blank for dev mode)
API_KEY=

# --- Application ---
LOG_LEVEL=INFO
PAPER_TRADING=true

# --- Execution mode ---
# shadow   = local sim (no IB), safe everywhere
# ib_paper = IB paper account (DU* / DUQ*), real-market sim
# ib_live  = REAL MONEY — requires LIVE_TRADING_CONFIRMED=true
EXECUTION_MODE=shadow
# Enable auto-execution from signal book after pre-compute. Safe for
# shadow + ib_paper; ib_live additionally requires LIVE_TRADING_CONFIRMED.
AUTO_EXECUTE=true
# Hard opt-in to real-money trading. Keep false unless you mean it.
LIVE_TRADING_CONFIRMED=false
# Per-order notional ceiling for ib_live. Acts as a second tripwire on
# top of LIVE_TRADING_CONFIRMED. Ignored in shadow / ib_paper.
MAX_SINGLE_ORDER_NOTIONAL=50000

# --- Continuous pipeline ---
# Toggle backend auto-start of the continuous ingestion worker.
# Keep false for local API/frontend development; set true for unattended runs.
CONTINUOUS_PIPELINE_ENABLED=false

# --- LLM orchestration (LangGraph swarm vs rule-based) ---
# True (default) = pipeline calls the full LangGraph swarm per ticker
# with a deterministic rule-based fallback on timeout / error.
# False           = rule-based only (faster, cheaper, no LLM cost).
LLM_ORCHESTRATION_ENABLED=true
# Per-ticker timeout for the LLM orchestrator. On timeout we fall back
# to the rule engine — the LLM is an enhancement, not a hard dep.
LLM_SIGNAL_TIMEOUT_SECONDS=45
# Cap on concurrent LLM calls so a 100-ticker cycle doesn't exhaust
# provider rate limits.
LLM_MAX_CONCURRENT_SIGNALS=5
# Legacy: live-LLM orchestrator inside execute_signal. Independent of
# LLM_ORCHESTRATION_ENABLED above (which gates the worker pipeline).
LLM_LIVE_ORCHESTRATOR=false
